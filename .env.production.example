# ─────────────────────────────────────────────────────────────────────────────
# Server environment for `docker compose --profile app up -d`.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Every value marked CHANGE ME must be replaced before the first start. The
# addresses of PostgreSQL and MinIO inside the stack are set by
# docker-compose.yml; this file holds secrets and external services only.
# See docs/deployment.md for the whole procedure.
# ─────────────────────────────────────────────────────────────────────────────

# Predictable names for containers' volumes: system112_postgres_data and so on.
COMPOSE_PROJECT_NAME=system112

NODE_ENV=production
VOICE_PIPELINE_DEMO_ENABLED=false
SCENARIO_AUDIO_WORKER_ENABLED=false
# Switch to local only after deploying and validating llama-server on the LAN.
LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://llm:8080/v1
# LOCAL_LLM_MODEL=training-model
# LOCAL_LLM_CONCURRENCY=1
# LOCAL_LLM_TIMEOUT_MS=8000
# Origins of the desktop app's webview on macOS, Linux and Windows.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost

# ── API ─────────────────────────────────────────────────────────────────────
# NGINX is the only published application endpoint. Certificates are mounted
# read-only and must be issued by the organisation's internal CA in production.
TLS_BIND_ADDRESS=0.0.0.0
TLS_PORT=443
TLS_CERTIFICATE_PATH=./ops/tls/certs/tls.crt
TLS_PRIVATE_KEY_PATH=./ops/tls/certs/tls.key

# ── Database ────────────────────────────────────────────────────────────────
# The password goes into a connection URL: generate it with `openssl rand -hex 24`
# so it has no characters that would need escaping.
POSTGRES_USER=system112
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-24
POSTGRES_DB=system112_training

# A backup is created at startup and then every 24 hours. Keep the directory on
# protected storage and copy it off-host. Restore always requires confirmation.
BACKUP_DIRECTORY=./var/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=93600

# ── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters: `openssl rand -base64 48`. Changing it signs every
# operator out.
JWT_SECRET=CHANGE-ME-openssl-rand-base64-48
JWT_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=7776000
# Set only while running `bun run db:seed:admin`, then remove from the server.
# SEED_ADMIN_EMAIL=admin@system112.local
# SEED_ADMIN_PASSWORD=CHANGE-ME-random-bootstrap-password
# SEED_ADMIN_FULL_NAME=Администратор системы

# ── Call recording ──────────────────────────────────────────────────────────
# MinIO runs in the same stack; the backend uses its root user.
CALL_RECORDING_ENABLED=true
CALL_RECORDING_S3_REGION=us-east-1
CALL_RECORDING_S3_BUCKET=call-recordings
MINIO_ROOT_USER=system112
MINIO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-24

# Grammar rules always run; the model review is opt-in.
GRAMMAR_MODEL_REVIEW_ENABLED=false

# ── Alice AI ────────────────────────────────────────────────────────────────
# Нужны только при LLM_PROVIDER=alice. Локальный контур их не использует.
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=aliceai-llm-flash
YANDEX_AI_REQUEST_TIMEOUT_MS=5000

# ── Speech recognition, synthesis and the local model ───────────────────────
# Все три сервиса поднимает тот же docker-compose, и адреса внутри стека он же
# подставляет: asr, piper-tts и local-llm. Менять их в .env нужно только когда
# сервис вынесен на другую машину — тогда укажите её адрес в частной сети.
QWEN_TTS_PROVIDER=piper
PIPER_TTS_MALE_VOICE=ru_RU-dmitri-medium
PIPER_TTS_FEMALE_VOICE=ru_RU-irina-medium
QWEN_TTS_REQUEST_TIMEOUT_MS=60000
# Модель llama-server скачивает при первом старте в том llm_models.
LOCAL_LLM_MODEL_FILE=qwen2.5-1.5b-instruct-q4_0.gguf
LOCAL_LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_0.gguf
LOCAL_LLM_TIMEOUT_MS=30000
LOCAL_LLM_CONCURRENCY=1
# Потоки распределяются между распознаванием, моделью и синтезом на одном CPU.
LOCAL_LLM_THREADS=4
LOCAL_LLM_THREADS_BATCH=4
WHISPER_THREADS=2

# ── Reverse geocoding ───────────────────────────────────────────────────────
# The public OSMF endpoint allows light use only; point this at a self-hosted
# Nominatim for a real training group.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=system-112-training/0.1
NOMINATIM_REQUEST_TIMEOUT_MS=5000
NOMINATIM_CACHE_TTL_SECONDS=86400

# ── Monitoring ──────────────────────────────────────────────────────────────
PROMETHEUS_CONFIG=prometheus.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-openssl-rand-hex-24

# Everything below listens on localhost only; reach it through an SSH tunnel.
POSTGRES_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1
PGADMIN_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE-ME-openssl-rand-hex-24

# ── Учебная IP-телефония (профиль compose telephony) ─────────────────
# Диспетчер ДДС передаёт карточку наряду по SIP, а наряд на том конце играет
# backend. Без TELEPHONY_ENABLED Asterisk не нужен и звонок наряду не обязателен.
TELEPHONY_ENABLED=false
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=system112
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=crew-handoff
# Общий с Asterisk каталог реплик: compose монтирует ./telephony-sounds/crew.
TELEPHONY_SOUNDS_DIR=./telephony-sounds
# Пароль SIP-учёток рабочих мест 201–204 и их список.
ASTERISK_SIP_PASSWORD=
ASTERISK_WORKSTATIONS=201,202,203,204
ASTERISK_WEBRTC_WORKSTATIONS=
ASTERISK_WEBRTC_WS_URL=wss://pbx.example.internal/ws
ASTERISK_WEBRTC_SIP_DOMAIN=pbx.example.internal
# Адрес хоста в сети класса, если телефоны видят Asterisk через NAT Docker.
ASTERISK_EXTERNAL_ADDRESS=
