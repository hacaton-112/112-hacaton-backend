FROM ubuntu:24.04

ARG BITNET_COMMIT=0b341e582afbf9e1011f24744b554c96a3477eb5

RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirror.yandex.ru/ubuntu|; s|http://security.ubuntu.com/ubuntu|http://mirror.yandex.ru/ubuntu|' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/bitnet
COPY patch-2b-model.py /tmp/patch-2b-model.py
RUN git clone --filter=blob:none https://github.com/microsoft/BitNet.git . \
    && git checkout "${BITNET_COMMIT}" \
    && git submodule update --init --recursive --depth 1 \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        ./3rdparty/llama.cpp/gguf-py \
        numpy==1.26.4 \
        protobuf==4.25.8 \
        safetensors==0.6.2 \
        sentencepiece==0.2.1 \
        transformers==4.57.6 \
        --extra-index-url https://download.pytorch.org/whl/cpu \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        torch==2.8.0 \
        --index-url https://download.pytorch.org/whl/cpu \
    && python3 /tmp/patch-2b-model.py \
    && python3 utils/codegen_tl2.py \
        --model BitNet-b1.58-2B-4T \
        --BM 256,128,256,128 \
        --BK 96,192,96,96 \
        --bm 32,32,32,32

COPY patch-converter.py /tmp/patch-converter.py
RUN python3 /tmp/patch-converter.py

ENTRYPOINT ["python3", "utils/convert-hf-to-gguf-bitnet.py"]
