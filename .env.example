NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY_HOPS=0
VOICE_PIPELINE_DEMO_ENABLED=false
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost
# Порт хоста для контейнера postgres. На Windows 54322 может оказаться в
# зарезервированном Hyper-V диапазоне (netsh int ipv4 show excludedportrange
# protocol=tcp) — тогда возьмите свободный порт и поправьте DATABASE_URL.
POSTGRES_PORT=54322
DATABASE_URL=postgresql://system112:system112@localhost:54322/system112_training
ASR_SERVICE_URL=http://127.0.0.1:8787

# Auth. JWT_SECRET must be at least 32 characters; generate a fresh one per
# environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=3600
# Refresh sessions. AUTH_REFRESH_TOKEN_TTL_SECONDS is the idle window of a
# single refresh token; AUTH_SESSION_TTL_SECONDS caps the whole rotation chain
# and is never extended by a refresh.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=7776000

# Local bootstrap account created by `bun run db:seed:admin`. Override these
# values before using the seed outside an isolated development environment.
SEED_ADMIN_EMAIL=admin@system112.local
SEED_ADMIN_PASSWORD=System112Admin2026!
SEED_ADMIN_FULL_NAME=Администратор системы

# Call recording. Off by default: without object storage nearby a developer
# should still get a working call. Credentials are required only once
# CALL_RECORDING_ENABLED is true; MinIO accepts its root user and password.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
CALL_RECORDING_S3_REGION=us-east-1
CALL_RECORDING_S3_BUCKET=call-recordings
# Defaults of the MinIO service in docker-compose.yml.
# CALL_RECORDING_S3_ACCESS_KEY_ID=system112
# CALL_RECORDING_S3_SECRET_ACCESS_KEY=system112secret

# Prometheus metrics. Served on a separate port, never next to the API, because
# they carry no authorization. Defaults are shown.
# METRICS_ENABLED=true
# METRICS_HOST=0.0.0.0
# METRICS_PORT=9464

# Grammar. Rules over the text typed by a person always run and need no
# network. The deeper review by the model is opt-in, because an isolated
# training room may have no provider at all.
GRAMMAR_MODEL_REVIEW_ENABLED=false

# Reverse geocoding. The public OSMF endpoint is suitable only for light
# development use: keep the proxy cache/rate limit enabled and use a self-hosted
# Nominatim URL in production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=system-112-training/0.1
NOMINATIM_REQUEST_TIMEOUT_MS=5000
NOMINATIM_CACHE_TTL_SECONDS=86400

# Синтез речи: Piper на процессоре, единственный провайдер тренажёра.
TTS_REQUEST_TIMEOUT_MS=60000
PIPER_TTS_BASE_URL=http://127.0.0.1:5000
PIPER_TTS_MALE_VOICE=ru_RU-dmitri-medium
PIPER_TTS_FEMALE_VOICE=ru_RU-irina-medium

# ── Docker Compose ──────────────────────────────────────────────────────────
# `docker compose up -d` starts the whole stack, backend included. Prometheus
# scrapes it inside compose. If you run the backend on the host instead
# (bun run start:dev), switch to prometheus.host.yml and stop the container.
PROMETHEUS_CONFIG=prometheus.yml
# Grafana is published at http://localhost:3001 with a provisioned dashboard.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# Services published by compose listen on localhost only. Change a bind address
# only if another machine really has to reach that service.
# POSTGRES_BIND_ADDRESS=127.0.0.1
# MINIO_BIND_ADDRESS=127.0.0.1
# PGADMIN_BIND_ADDRESS=127.0.0.1
# GRAFANA_BIND_ADDRESS=127.0.0.1
# PROMETHEUS_BIND_ADDRESS=127.0.0.1

# Hybrid dialogue: private S3 and working local TTS are required for preparation.
# Existing runtime behavior is preserved until the worker is explicitly enabled.
SCENARIO_AUDIO_WORKER_ENABLED=false
# legacy — два вызова с JSON; caller-v2 — один вызов дообученного заявителя.
LLM_REPLY_PROTOCOL=legacy
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=training-model
LLM_TIMEOUT_MS=30000
LLM_INTENT_TIMEOUT_MS=2500
LLM_REPLY_MAX_TOKENS=256
LLM_REPLY_TEMPERATURE=0.3
# На 0.6B thinking часто съедает весь лимит ответа. Включайте после A/B на модели >=1.5B.
LLM_REPLY_THINKING=false
# Единственный CPU-слот отдан живому звонку. Для локальной проверки грамотности
# и помощника сценария увеличьте и этот лимит, и --parallel у llama-server.
LLM_CONCURRENCY=1
# LLM_API_KEY=local-server-key-if-required
# Не-диалоговые JSON-задачи идут в отдельную модель и не занимают слот звонка.
# Если адрес не задан, сохраняется прежнее поведение: используется основной LLM.
TOOLS_LLM_BASE_URL=http://127.0.0.1:8081/v1
TOOLS_LLM_MODEL=tools-model
TOOLS_LLM_TIMEOUT_MS=120000
TOOLS_LLM_CONCURRENCY=1
# Выводы ИИ по завершённому занятию ДДС готовит tools-llm в фоне; на
# отдельной копии backend обработчик выключают значением false.
DDS_INSIGHTS_WORKER_ENABLED=true
BACKGROUND_QUEUE_POLL_MS=2000
# Черновики сценариев помощника готовятся в фоне, по очереди на всех
# преподавателей. Одновременно — по числу слотов tools-llm (по умолчанию как
# TOOLS_LLM_CONCURRENCY). Выключить обработчик на отдельной копии backend:
# SCENARIO_GENERATION_WORKER_ENABLED=false.
SCENARIO_GENERATION_CONCURRENCY=1
SCENARIO_GENERATION_WORKER_ENABLED=true
# Модель меняется от итерации к итерации, поэтому имя файла нейтральное.
# Файл кладут в том llm_models заранее или задают LLM_MODEL_URL для скачивания.
# Для caller-v2 — дообученный заявитель в Q6_K: Q4 на 0.6B путает адреса и числа.
LLM_MODEL_FILE=caller.gguf
LLM_MODEL_URL=
# Образ llama-server; тег фиксируют после прогона бенчмарка на целевом CPU.
LLM_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLM_THREADS=12
LLM_THREADS_BATCH=12
LLM_PARALLEL=2
LLM_POLL=0
LLM_EXTRA_ARGS=
# Путь внутри общего тома llm_models. На сервере модель уже лежит в HF-кеше.
TOOLS_LLM_MODEL_FILE=hf/models--unsloth--gemma-4-E2B-it-qat-GGUF/snapshots/66a399f68ddd113b06dff02fca9523e55465d11d/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
TOOLS_LLM_MODEL_URL=
TOOLS_LLM_THREADS=4
TOOLS_LLM_THREADS_BATCH=4
TOOLS_LLM_POLL=1000
# Потоки распознавания Sherpa-ONNX: на боевом сервере — по числу ядер.
ASR_THREADS=6

# ── Учебная IP-телефония ─────────────────────────────────────────────
# Диспетчер ДДС передаёт карточку наряду по SIP, а наряд на том конце играет
# backend. Без TELEPHONY_ENABLED Asterisk не нужен и звонок наряду не обязателен.
TELEPHONY_ENABLED=false
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=system112
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=crew-handoff
# Asterisk отправляет сюда входящий RTP для локального ASR. Для backend в
# compose используется имя `backend`, при запуске Bun на хосте Docker Desktop —
# `host.docker.internal`.
ASTERISK_MEDIA_HOST=host.docker.internal
ASTERISK_MEDIA_BIND_HOST=0.0.0.0
# Общий с Asterisk каталог реплик: compose монтирует ./telephony-sounds/crew.
TELEPHONY_SOUNDS_DIR=./telephony-sounds
# Пароль SIP-учёток рабочих мест 201–204 и их список.
ASTERISK_SIP_PASSWORD=
ASTERISK_WORKSTATIONS=201,202,203,204
# Подмножество рабочих мест, которые регистрируются из browser/Tauri webview.
# Они получают отдельные HMAC-пароли и несовместимы с обычным SIP-телефоном.
ASTERISK_WEBRTC_WORKSTATIONS=
# Для локального browser dev достаточно ws://localhost; production требует WSS.
ASTERISK_WEBRTC_WS_URL=ws://127.0.0.1:8088/ws
ASTERISK_WEBRTC_SIP_DOMAIN=localhost
# Адрес хоста в сети класса, если телефоны видят Asterisk через NAT Docker.
ASTERISK_EXTERNAL_ADDRESS=

# ── Карта происшествий ───────────────────────────────────────────────
# Тайлы Москвы и области отдаёт TileServer из maps/ (см. maps/README.md).
# Публичный адрес: на сервере карта проксируется gateway по /maps/, в
# разработке контейнер слушают напрямую.
MAP_TILESERVER_PUBLIC_URL=http://127.0.0.1:8080/
# Список разрешённых Host через запятую; по умолчанию разрешены любые.
MAP_TILESERVER_ALLOWED_HOSTS=*

# ── Адрес по точке на карте ──────────────────────────────────────────
# Обратное геокодирование собирается из собственных тайлов: слой домов даёт
# номер, слой дорог — улицу, слой мест — город. Внешний Nominatim остаётся
# только для разработки и в закрытом контуре недоступен.
REVERSE_GEOCODER_PROVIDER=tiles
MAP_TILES_BASE_URL=http://127.0.0.1:8080/data/openmaptiles
MAP_TILES_TIMEOUT_MS=3000

# ── Журнал аудита ────────────────────────────────────────────
# Записи старше срока удаляются уборщиком раз в шесть часов.
AUDIT_LOG_RETENTION_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# ── Одновременные звонки ─────────────────────────────────────
# Модель отвечает по одному ходу за раз; очередь даёт второму оператору
# дождаться настоящего ответа вместо сценарной заглушки.
LLM_QUEUE_SIZE=3
LLM_QUEUE_WAIT_MS=8000
DATABASE_POOL_MAX=20
