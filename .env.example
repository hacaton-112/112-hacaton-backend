NODE_ENV=development
HOST=0.0.0.0
PORT=3000
VOICE_PIPELINE_DEMO_ENABLED=false
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost
# Порт хоста для контейнера postgres. На Windows 54322 может оказаться в
# зарезервированном Hyper-V диапазоне (netsh int ipv4 show excludedportrange
# protocol=tcp) — тогда возьмите свободный порт и поправьте DATABASE_URL.
POSTGRES_PORT=54322
DATABASE_URL=postgresql://system112:system112@localhost:54322/system112_training
ASR_SERVICE_URL=http://127.0.0.1:8787

# Auth. JWT_SECRET must be at least 32 characters; generate a fresh one per
# environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=3600
# Refresh sessions. AUTH_REFRESH_TOKEN_TTL_SECONDS is the idle window of a
# single refresh token; AUTH_SESSION_TTL_SECONDS caps the whole rotation chain
# and is never extended by a refresh.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=7776000

# Call recording. Off by default: without object storage nearby a developer
# should still get a working call. Credentials are required only once
# CALL_RECORDING_ENABLED is true; MinIO accepts its root user and password.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
CALL_RECORDING_S3_REGION=us-east-1
CALL_RECORDING_S3_BUCKET=call-recordings
# Defaults of the MinIO service in docker-compose.yml.
# CALL_RECORDING_S3_ACCESS_KEY_ID=system112
# CALL_RECORDING_S3_SECRET_ACCESS_KEY=system112secret

# Required only when AliceAiAdapterModule is instantiated.
# YANDEX_AI_API_KEY=replace-with-service-account-api-key
# YANDEX_AI_FOLDER_ID=replace-with-yandex-cloud-folder-id
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=aliceai-llm-flash
YANDEX_AI_REQUEST_TIMEOUT_MS=5000

# Reverse geocoding. The public OSMF endpoint is suitable only for light
# development use: keep the proxy cache/rate limit enabled and use a self-hosted
# Nominatim URL in production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=system-112-training/0.1
NOMINATIM_REQUEST_TIMEOUT_MS=5000
NOMINATIM_CACHE_TTL_SECONDS=86400

# Qwen3-TTS runtime. Defaults below target native MLX-Audio on Apple Silicon.
QWEN_TTS_PROVIDER=mlx-audio
QWEN_TTS_MODE=custom-voice
QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
QWEN_TTS_STREAMING_INTERVAL_SECONDS=0.32
QWEN_TTS_REQUEST_TIMEOUT_MS=60000

# Server target: vLLM-Omni on Linux with NVIDIA CUDA. The Docker service uses
# its own model setting so it can bootstrap a reference with CustomVoice first.
# QWEN_TTS_PROVIDER=vllm-omni
# QWEN_TTS_BASE_URL=http://127.0.0.1:8091
# QWEN_TTS_MODE=base-icl
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_REFERENCE_VOICES_PATH=assets/tts-references/reference-voices.json
# QWEN_TTS_CUDA_IMAGE=vllm/vllm-omni:v0.28.0
# QWEN_TTS_CUDA_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_CUDA_BIND_ADDRESS=127.0.0.1
# QWEN_TTS_CUDA_PORT=8091
# HF_TOKEN=only-required-for-private-or-rate-limited-model-downloads

# Base + ICL keeps one synthetic reference voice across all replies. The Base
# checkpoint has no speakers of its own — it speaks with the voice it is given,
# and the repository ships one:
# QWEN_TTS_MODE=base-icl
# QWEN_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
# QWEN_TTS_REFERENCE_VOICES_PATH=assets/tts-references/reference-voices.json
# Add voices with `bun run prepare:tts-reference` — see the folder's README.
