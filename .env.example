NODE_ENV=development
HOST=0.0.0.0
PORT=3000
VOICE_PIPELINE_DEMO_ENABLED=false
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost
# Порт хоста для контейнера postgres. На Windows 54322 может оказаться в
# зарезервированном Hyper-V диапазоне (netsh int ipv4 show excludedportrange
# protocol=tcp) — тогда возьмите свободный порт и поправьте DATABASE_URL.
POSTGRES_PORT=54322
DATABASE_URL=postgresql://system112:system112@localhost:54322/system112_training
ASR_SERVICE_URL=http://127.0.0.1:8787

# Auth. JWT_SECRET must be at least 32 characters; generate a fresh one per
# environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=3600
# Refresh sessions. AUTH_REFRESH_TOKEN_TTL_SECONDS is the idle window of a
# single refresh token; AUTH_SESSION_TTL_SECONDS caps the whole rotation chain
# and is never extended by a refresh.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=7776000

# Local bootstrap account created by `bun run db:seed:admin`. Override these
# values before using the seed outside an isolated development environment.
SEED_ADMIN_EMAIL=admin@system112.local
SEED_ADMIN_PASSWORD=System112Admin2026!
SEED_ADMIN_FULL_NAME=Администратор системы

# Call recording. Off by default: without object storage nearby a developer
# should still get a working call. Credentials are required only once
# CALL_RECORDING_ENABLED is true; MinIO accepts its root user and password.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
CALL_RECORDING_S3_REGION=us-east-1
CALL_RECORDING_S3_BUCKET=call-recordings
# Defaults of the MinIO service in docker-compose.yml.
# CALL_RECORDING_S3_ACCESS_KEY_ID=system112
# CALL_RECORDING_S3_SECRET_ACCESS_KEY=system112secret

# Prometheus metrics. Served on a separate port, never next to the API, because
# they carry no authorization. Defaults are shown.
# METRICS_ENABLED=true
# METRICS_HOST=0.0.0.0
# METRICS_PORT=9464

# Grammar. Rules over the text typed by a person always run and need no
# network. The deeper review by the model is opt-in, because an isolated
# training room may have no provider at all.
GRAMMAR_MODEL_REVIEW_ENABLED=false

# Required only when AliceAiAdapterModule is instantiated.
# YANDEX_AI_API_KEY=replace-with-service-account-api-key
# YANDEX_AI_FOLDER_ID=replace-with-yandex-cloud-folder-id
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=aliceai-llm-flash
YANDEX_AI_REQUEST_TIMEOUT_MS=5000

# Reverse geocoding. The public OSMF endpoint is suitable only for light
# development use: keep the proxy cache/rate limit enabled and use a self-hosted
# Nominatim URL in production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=system-112-training/0.1
NOMINATIM_REQUEST_TIMEOUT_MS=5000
NOMINATIM_CACHE_TTL_SECONDS=86400

# Qwen3-TTS runtime. Defaults below target native MLX-Audio on Apple Silicon.
QWEN_TTS_PROVIDER=piper
QWEN_TTS_MODE=custom-voice
QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
QWEN_TTS_STREAMING_INTERVAL_SECONDS=0.32
QWEN_TTS_REQUEST_TIMEOUT_MS=60000
PIPER_TTS_BASE_URL=http://127.0.0.1:5000
PIPER_TTS_MALE_VOICE=ru_RU-dmitri-medium
PIPER_TTS_FEMALE_VOICE=ru_RU-irina-medium

# Server target: vLLM-Omni on Linux with NVIDIA CUDA. The Docker service uses
# its own model setting so it can bootstrap a reference with CustomVoice first.
# QWEN_TTS_PROVIDER=vllm-omni
# QWEN_TTS_BASE_URL=http://127.0.0.1:8091
# QWEN_TTS_MODE=base-icl
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_REFERENCE_VOICES_PATH=assets/tts-references/reference-voices.json
# QWEN_TTS_CUDA_IMAGE=vllm/vllm-omni:v0.28.0
# QWEN_TTS_CUDA_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_TTS_CUDA_BIND_ADDRESS=127.0.0.1
# QWEN_TTS_CUDA_PORT=8091
# HF_TOKEN=only-required-for-private-or-rate-limited-model-downloads

# Base + ICL keeps one synthetic reference voice across all replies. The Base
# checkpoint has no speakers of its own — it speaks with the voice it is given,
# and the repository ships one:
# QWEN_TTS_MODE=base-icl
# QWEN_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
# QWEN_TTS_REFERENCE_VOICES_PATH=assets/tts-references/reference-voices.json
# Add voices with `bun run prepare:tts-reference` — see the folder's README.

# ── Docker Compose ──────────────────────────────────────────────────────────
# `docker compose up -d` starts the whole stack, backend included. Prometheus
# scrapes it inside compose. If you run the backend on the host instead
# (bun run start:dev), switch to prometheus.host.yml and stop the container.
PROMETHEUS_CONFIG=prometheus.yml
# Grafana is published at http://localhost:3001 with a provisioned dashboard.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# Services published by compose listen on localhost only. Change a bind address
# only if another machine really has to reach that service.
# POSTGRES_BIND_ADDRESS=127.0.0.1
# MINIO_BIND_ADDRESS=127.0.0.1
# PGADMIN_BIND_ADDRESS=127.0.0.1
# GRAFANA_BIND_ADDRESS=127.0.0.1
# PROMETHEUS_BIND_ADDRESS=127.0.0.1

# Hybrid dialogue: private S3 and working local TTS are required for preparation.
# Existing runtime behavior is preserved until the worker is explicitly enabled.
SCENARIO_AUDIO_WORKER_ENABLED=false
# LLM_PROVIDER=local switches ALL text AI tools to the local server; no cloud fallback.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=training-model
LOCAL_LLM_TIMEOUT_MS=30000
# Единственный CPU-слот отдан живому звонку. Для локальной проверки грамотности
# и помощника сценария увеличьте и этот лимит, и --parallel у llama-server.
LOCAL_LLM_CONCURRENCY=1
# LOCAL_LLM_API_KEY=local-server-key-if-required
# Official BitNet b1.58 2B/4T in the I2_S layout optimized by bitnet.cpp.
# Defaults below are benchmarked on a Ryzen 5 5600: 8 threads gave the best
# token generation rate, while all 12 logical threads process prompt batches.
LOCAL_LLM_MODEL_FILE=bitnet-b1.58-2B-4T-i2_s.gguf
LOCAL_LLM_MODEL_URL=https://huggingface.co/microsoft/BitNet-b1.58-2B-4T-gguf/resolve/main/ggml-model-i2_s.gguf
LOCAL_LLM_THREADS=8
LOCAL_LLM_THREADS_BATCH=12
# Pin the tested upstream source; update deliberately after running the smoke test.
BITNET_COMMIT=0b341e582afbf9e1011f24744b554c96a3477eb5

# ── Учебная IP-телефония ─────────────────────────────────────────────
# Диспетчер ДДС передаёт карточку наряду по SIP, а наряд на том конце играет
# backend. Без TELEPHONY_ENABLED Asterisk не нужен и звонок наряду не обязателен.
TELEPHONY_ENABLED=false
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=system112
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=crew-handoff
# Общий с Asterisk каталог реплик: compose монтирует ./telephony-sounds/crew.
TELEPHONY_SOUNDS_DIR=./telephony-sounds
# Пароль SIP-учёток рабочих мест 201–204 и их список.
ASTERISK_SIP_PASSWORD=
ASTERISK_WORKSTATIONS=201,202,203,204
# Адрес хоста в сети класса, если телефоны видят Asterisk через NAT Docker.
ASTERISK_EXTERNAL_ADDRESS=
