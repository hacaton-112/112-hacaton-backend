{
  "uid": "system112-overview",
  "title": "Тренажёр 112 — состояние системы",
  "description": "Доступность, ошибки, задержки и активные alerts backend и ASR",
  "tags": ["system112", "overview"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Сервисы и alerts",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend",
      "description": "Последний результат scrape backend.",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Недоступен", "color": "red" },
                "1": { "text": "Работает", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"system112-backend\"})",
          "instant": true,
          "legendFormat": "Backend"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ASR",
      "description": "Последний результат scrape ASR.",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Недоступен", "color": "red" },
                "1": { "text": "Работает", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"system112-asr\"})",
          "instant": true,
          "legendFormat": "ASR"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Голосовые сессии",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(system112_voice_sessions)",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "ASR WebSocket",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 14, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(system112_asr_sessions)",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Firing alerts",
      "description": "Активные правила Prometheus любой severity.",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Запросы и задержки",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP-запросы",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system112:backend_http_requests:rate5m",
          "legendFormat": "backend"
        },
        {
          "refId": "B",
          "expr": "system112:asr_http_requests:rate5m",
          "legendFormat": "ASR"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Доля HTTP 5xx",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system112:backend_http_errors:ratio5m",
          "legendFormat": "backend"
        },
        {
          "refId": "B",
          "expr": "system112:asr_http_errors:ratio5m",
          "legendFormat": "ASR"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP p95",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system112:backend_http_latency:p95_5m",
          "legendFormat": "backend"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(system112_asr_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "ASR"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Активные предупреждения",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "panels": []
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Состояние alert rules",
      "description": "Pending и firing состояния по имени правила и severity.",
      "datasource": { "type": "prometheus", "uid": "system112-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OK", "color": "green" },
                "1": { "text": "Alert", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (alertname, severity, alertstate) (ALERTS{alertname=~\"System112.*\"})",
          "legendFormat": "{{severity}} · {{alertname}} · {{alertstate}}"
        }
      ]
    }
  ]
}
