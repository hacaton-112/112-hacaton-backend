{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "useESM": true, "tsconfig": "<rootDir>/test/tsconfig-e2e.json" }
    ]
  },
  "moduleNameMapper": {
    "^(?:@/core/config/env\\.config|\\./config/env\\.config)$": "<rootDir>/test/e2e/env-mock.ts",
    "^@/(.*)$": ["<rootDir>/src/$1", "<rootDir>/$1"]
  },
  "setupFiles": ["<rootDir>/test/e2e/setup-env.ts"],
  "testEnvironment": "node",
  "testTimeout": 30000
}
